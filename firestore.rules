rules_version = '2';
// Firestore rules for the Vorion Batch Book project.
// Only the collections the app uses are open; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{doc}   { allow read, write: if true; }
    match /entries/{doc}    { allow read, write: if true; }
    match /stock/{doc}      { allow read, write: if true; }
    match /dayLabour/{doc}  { allow read, write: if true; }
    match /{document=**}    { allow read, write: if false; }
  }
}
